<mxfile host="app.diagrams.net">
  <diagram name="Import Pipeline" id="import-pipeline">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="Dataset Loading Pipeline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="30" as="geometry" />
        </mxCell>
        
        <!-- Stage 1: Data Generation -->
        <mxCell id="stage1-box" value="STAGE 1: DATA GENERATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="stage1-desc" value="Python Scripts:&#xa;src/original.py, src/generate.py" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="stage1-process" value="• Generate customer profiles (x, y, spending patterns)&#xa;• Generate terminal profiles (x, y locations)&#xa;• Generate transactions (temporal distribution)&#xa;• Add fraud markers" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stage1-output" value="Output: Pandas DataFrames&#xa;(customers, terminals, transactions)" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="300" height="50" as="geometry" />
        </mxCell>
        
        <!-- Arrow Stage 1 to Stage 2 -->
        <mxCell id="arrow1" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=3;strokeColor=#6c8ebf;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage1-output" target="stage2-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <!-- Stage 2: Data Transformation -->
        <mxCell id="stage2-box" value="STAGE 2: DATA TRANSFORMATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="stage2-desc" value="Python Script:&#xa;src/converters.py (Converters.to_csv)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="150" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="stage2-process" value="• Add total_tx_count to Customer nodes&#xa;• Extract year/quarter from transactions&#xa;• Create Quarter nodes with pre-computed medians&#xa;• Generate relationship CSV files:&#xa;  - cust_tx.csv (MADE_TRANSACTION)&#xa;  - tx_term.csv (AT_TERMINAL)&#xa;  - transaction_quarter.csv (IN_QUARTER)&#xa;  - used_terminal.csv (USED_TERMINAL with tx_count)" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="200" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stage2-output" value="Output: Neo4j CSV Files&#xa;• customers.csv, terminals.csv&#xa;• transactions.csv, quarters.csv&#xa;• Relationship CSV files" style="text;html=1;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="480" y="370" width="300" height="60" as="geometry" />
        </mxCell>
        
        <!-- Arrow Stage 2 to Stage 3 -->
        <mxCell id="arrow2" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=3;strokeColor=#d6b656;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage2-output" target="stage3-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <!-- Stage 3: Database Import -->
        <mxCell id="stage3-box" value="STAGE 3: DATABASE IMPORT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="stage3-desc" value="Docker Entrypoint:&#xa;custom-entrypoint.sh" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="150" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="stage3-process" value="1. Check if database exists&#xa;2. If new: Run neo4j-admin bulk import&#xa;   • Import all nodes and relationships&#xa;   • Single atomic operation&#xa;   • 10-50x faster than CREATE statements&#xa;3. Create marker file for constraints&#xa;4. Start Neo4j server&#xa;5. Wait for Neo4j to be ready" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="200" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="stage3-output" value="Output: Populated Neo4j Database&#xa;(nodes and relationships loaded)" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="880" y="350" width="300" height="50" as="geometry" />
        </mxCell>
        
        <!-- Arrow Stage 3 to Constraints -->
        <mxCell id="arrow3" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=3;strokeColor=#82b366;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage3-output" target="constraints-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <!-- Constraints Application -->
        <mxCell id="constraints-box" value="CONSTRAINTS &amp; INDEXES APPLICATION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;align=center;" vertex="1" parent="1">
          <mxGeometry x="880" y="450" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="constraints-desc" value="File: constraints.cypher" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="500" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="constraints-process" value="• Apply UNIQUE constraints:&#xa;  customerId, terminalId, transactionId&#xa;• Create indexes on frequently queried properties:&#xa;  fraud, datetime, amount, prev_median&#xa;• Remove marker file" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="540" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="constraints-output" value="Output: Fully Initialized Database&#xa;(ready for queries)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="880" y="660" width="300" height="50" as="geometry" />
        </mxCell>
        
        <!-- neo4j-admin command box -->
        <mxCell id="command-box" value="neo4j-admin database import full" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="command-details" value="--nodes=customers.csv&#xa;--nodes=terminals.csv&#xa;--nodes=transactions.csv&#xa;--nodes=quarters.csv&#xa;--relationships=cust_tx.csv&#xa;--relationships=tx_term.csv&#xa;--relationships=used_terminal.csv&#xa;--relationships=transaction_quarter.csv" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;spacingLeft=10;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="80" y="550" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="command-performance" value="Performance: 30-60s for 200MB dataset" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="80" y="680" width="300" height="30" as="geometry" />
        </mxCell>
        
        <!-- Connection from Stage 2 to command box -->
        <mxCell id="arrow-command" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d6b656;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="stage2-output" target="command-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <!-- Connection from command box to Stage 3 -->
        <mxCell id="arrow-command2" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d6b656;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="command-box" target="stage3-box">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        
        <!-- Legend -->
        <mxCell id="legend-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;dashPattern=8 8;" vertex="1" parent="1">
          <mxGeometry x="80" y="750" width="1100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="legend-title" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="760" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-1" value="Stage 1: Python data generation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="790" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-2" value="Stage 2: CSV transformation and pre-computation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="790" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-3" value="Stage 3: Bulk import via neo4j-admin" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="790" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legend-4" value="Final: Constraints and indexes application" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="790" width="250" height="20" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
